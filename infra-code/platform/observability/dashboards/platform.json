{
  "uid": "infra-ai-platform",
  "title": "Infra-AI Platform — capacity, gateway, logs",
  "tags": ["infra-ai", "platform"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "namespace",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(container_memory_working_set_bytes, namespace)",
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Capacity (host has ~7 GiB usable)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Cluster memory working set (total)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 5500000000 },
              { "color": "red", "value": 6500000000 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(container_memory_working_set_bytes{container!=\"\",container!=\"POD\"})",
          "legendFormat": "cluster total"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Memory working set by pod",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(15, sum by (namespace, pod) (container_memory_working_set_bytes{container!=\"\",container!=\"POD\",namespace=~\"$namespace\"}))",
          "legendFormat": "{{namespace}}/{{pod}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "table",
      "title": "Pods above 80% of their memory limit",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "format": "table",
          "expr": "sort_desc(sum by (namespace, pod) (container_memory_working_set_bytes{container!=\"\",container!=\"POD\"}) / clamp_min(sum by (namespace, pod) (container_spec_memory_limit_bytes{container!=\"\",container!=\"POD\"}), 1) > 0.8)"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "CPU throttling by pod",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (namespace, pod) (rate(container_cpu_cfs_throttled_periods_total{container!=\"\",namespace=~\"$namespace\"}[5m])))",
          "legendFormat": "{{namespace}}/{{pod}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "row",
      "title": "Kong gateway",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Kong requests by route and status",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route, code) (rate(kong_http_requests_total[5m]))",
          "legendFormat": "{{route}} {{code}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Kong latency p95 (request + upstream)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(kong_request_latency_ms_bucket[5m])))",
          "legendFormat": "request {{route}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(kong_upstream_latency_ms_bucket[5m])))",
          "legendFormat": "upstream {{route}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Gemini token usage through Kong ai-proxy",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 26 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (ai_model, ai_provider) (rate(kong_ai_llm_provider_tokens_total[5m]))",
          "legendFormat": "{{ai_provider}}/{{ai_model}}"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "agent-backend errors by type",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 26 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (type) (rate(agent_backend_errors_total[5m]))",
          "legendFormat": "{{type}}"
        }
      ]
    },
    {
      "id": 20,
      "type": "row",
      "title": "Object store and documents",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 34 }
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "MinIO bucket usage",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 35 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (bucket) (minio_bucket_usage_total_bytes)",
          "legendFormat": "{{bucket}}"
        }
      ]
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "PDF ingestion throughput (chunks/s)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 35 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(agent_backend_ingest_chunks_total[5m]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 30,
      "type": "row",
      "title": "Logs",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 43 }
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "Log volume by namespace",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 44 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (namespace) (count_over_time({cluster=\"mvp-k3d\"} [5m]))",
          "legendFormat": "{{namespace}}"
        }
      ]
    },
    {
      "id": 32,
      "type": "logs",
      "title": "agent-backend errors and warnings",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 52 },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{namespace=\"ai-platform\", app=\"agent-backend\"} |~ \"(?i)error|warn|exception|traceback\""
        }
      ]
    }
  ]
}
