        DATASETS[evals/datasets golden sets]
        PROMPTS[5 judge prompts]
    end

    S_K -->|OTLP gRPC| ALLOY
    S_O -->|OTLP| ALLOY
    S_W -->|OTLP| ALLOY
    S_M -->|OTLP| ALLOY
    S_R -->|OTLP| ALLOY
