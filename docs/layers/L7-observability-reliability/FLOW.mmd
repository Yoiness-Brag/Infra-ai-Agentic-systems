    GRAF --> MIM
    GRAF --> LOK
    GRAF --> TEM
    GRAF --> PYR

    LFW --> LFWORKER
    LFWORKER --> CHX
    LFW --> PGL
    LFW --> RDL
    LFW --> MINIO

    EVS -->|read traces| LFW
    EVS -->|write scores| LFW
    ONLINE --> EVS
    OFFLINE --> EVS
    DATASETS --> OFFLINE
    PROMPTS --> EVS

    classDef store fill:#e8f0fe,stroke:#1a73e8,color:#000
