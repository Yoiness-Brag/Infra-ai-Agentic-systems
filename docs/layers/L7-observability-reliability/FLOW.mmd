        LFWORKER[Langfuse Worker]
        CHX[(ClickHouse<br/>traces + audit)]
        PGL[(Postgres Langfuse meta)]
        RDL[(Redis Langfuse queue)]
        MINIO[(MinIO S3)]
    end

    subgraph EVAL[Harness composition]
        EVS[eval-svc]
