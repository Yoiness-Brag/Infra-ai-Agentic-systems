%% L7 — Observability: Alloy unified pipeline + eval feedback loop
flowchart LR
    subgraph EMIT[Emit sources L1 to L6]
        S_K[Kong L1]
        S_O[agent-orchestrator L3]
        S_W[agent-worker L3]
        S_M[memory-svc L4]
        S_R[mcp-sandbox-runner L5]
        S_K8S[kube-state-metrics + node-exporter]
    end

    subgraph PIPE[Grafana Alloy clustered 3-replica]
        ALLOY[Alloy unified collector<br/>OTLP receive + Prometheus scrape<br/>Loki push + Pyroscope native]
        OTTL[OTTL processors<br/>PII redaction + sampling]
        FAN[Native exporters]
